# =============================================================================
#  FRONTEND ENVIRONMENT VARIABLES (Vite)
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in real values.
#  NOTE: Vite inlines these at BUILD time — rebuild after changing them.
#  The VITE_SHIPPING_COST / VITE_COD / VITE_TAX_RATE values MUST match the
#  backend's SHIPPING_COST / COD / TAX_RATE, or checkout totals will be rejected.
# =============================================================================

# Base URL of the backend API (include trailing slash).
VITE_API_URL="http://localhost:3000/"

# Order charges / tax — keep in sync with the backend.
VITE_SHIPPING_COST=65
VITE_COD=40
VITE_TAX_RATE=12
