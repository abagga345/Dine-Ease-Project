// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum roletype {
  Admin
  User
}

model Users {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  firstName   String
  lastName    String
  contactNo   String
  password    String
  addresses  Address[]
  orders Orders[]
  reviews Reviews[]
  role roletype @default(User)
  storeId    String?
  store      Store? @relation(fields: [storeId], references: [storeId])
}

model Address {
  id          Int    @id @default(autoincrement())
  email       String
  houseStreet String
  city        String
  pincode     String
  user        Users   @relation(fields: [email], references: [email])
}

enum status {
  Unconfirmed
  Rejected
  Processing
  Delivered
  Dispatched
}

model Orders {
  id          Int          @id @default(autoincrement())
  items       OrderItems[]
  amount      Int
  description String
  status      status
  email    String
  creationDate   DateTime  @default(now())
  user        Users     @relation(fields: [email], references: [email])
  storeId     String
  store       Store @relation(fields: [storeId],references: [storeId])
}

model OrderItems {
  id          Int    @id @default(autoincrement())
  quantity    Int
  itemId      Int
  orderId     Int 
  order Orders @relation(fields: [orderId],references: [id])
  item Menu @relation(fields: [itemId],references: [id])
}

model Reviews{
  id Int @id @default(autoincrement())
  email String
  itemId Int
  description String
  rating Int
  item Menu @relation(fields: [itemId],references: [id])
  user        Users     @relation(fields: [email], references: [email])
}



model Menu {
  id          Int    @id @default(autoincrement())
  imageUrl    String
  title       String
  amount      Int
  description     String
  visibility  Boolean @default(true)
  storeId     String
  store       Store   @relation(fields: [storeId], references: [storeId])
  orders      OrderItems[]
  review      Reviews[]
}

model Store {
  id          Int       @id @default(autoincrement())
  storeId     String    @unique
  storeStreet String
  city        String
  pincode     String
  admins      Users[]
  menu        Menu[]
  orders      Orders[]
}
