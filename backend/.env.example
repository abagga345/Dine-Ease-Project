# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/dineease

# Secret used to sign/verify JWTs (required)
JWT_SECRET=replace-with-a-long-random-secret

# Mailjet API credentials for sending OTP / order emails
MAIL_JET_PUBLIC_KEY=your-mailjet-public-key
MAIL_JET_PRIVATE_KEY=your-mailjet-private-key

# Cloudinary credentials for image upload/delete
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Flat shipping charge added to every order (in currency units)
SHIPPING_COST=65

# Extra charge applied when paymentMethod is COD
COD=40

# Tax rate applied to the order total, as a percentage
TAX_RATE=12

# Port the HTTP server listens on
PORT=3000

# Comma-separated list of allowed CORS origins (unset = allow all)
CORS_ORIGIN=http://localhost:5173

# Set to "production" on AWS — switches the logger to JSON output for CloudWatch
NODE_ENV=development

# Log verbosity: trace|debug|info|warn|error|fatal|silent (defaults: debug dev / info prod)
LOG_LEVEL=debug
